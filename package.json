{
  "name": "ro-intel-reform-dataflows",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e && npm audit --audit-level=high"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
